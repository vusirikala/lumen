# Lumen deployment configuration example for self-hosted vLLM backends.

# Optional Redis for health/state.
# REDIS_URL=redis://localhost:6379/0

# OpenAI-compatible inference backend endpoint (vLLM service URL).
INFERENCE_BASE_URL=http://127.0.0.1:8001
# Optional backend token if your gateway requires auth.
# INFERENCE_API_KEY=replace-me

# Allowed model catalog exposed by /v1/models.
INFERENCE_MODEL_IDS=Qwen/Qwen2.5-7B-Instruct,Qwen/Qwen2.5-14B-Instruct,mistralai/Mistral-7B-Instruct-v0.3,google/gemma-2-9b-it
DEFAULT_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
ALLOW_UNKNOWN_MODELS=false

# Proxy behavior tuned for production.
PROXY_CHAT_TIMEOUT_SECONDS=180
PROXY_COMPLETION_TIMEOUT_SECONDS=120
PROXY_EMBEDDING_TIMEOUT_SECONDS=60
PROXY_MAX_RETRIES=2
PROXY_RETRY_BACKOFF_SECONDS=0.2

